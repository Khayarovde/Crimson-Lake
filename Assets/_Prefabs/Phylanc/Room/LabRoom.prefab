  pages:
  - "\u041A\u0440\u043E\u0432\u0430\u0432\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u043A\u0430
    \u0443 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0430"
  - "\u2026 \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0440\u043E\u0432\u0438,
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u0431\u044B \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u043B\r\n\u0434\u043E\u043B\u0436\u043D\u043E
    \u0431\u044B\u0442\u044C, \u043C\u043E\u044F \u043C\u0435\u0442\u0430\u043C\u043E\u0440\u0444\u043E\u0437\u0430
    \u0431\u0443\u0434\u0435\u0442 \u0443\u0436\u0430\u0441\u0430\u044E\u0449\u0435\u0439\u2026\r\n(\u043D\u0435\u0440\u0430\u0437\u0431\u043E\u0440\u0447\u0438\u0432\u043E),
    \u043B\u0438\u0448\u044C \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u0442\u044B
    \u043D\u0430\u0439\u0434\u0435\u0448\u044C \u043C\u043E\u0438 \u0437\u0430\u043F\u0438\u0441\u0438
    \u0438 \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C\u0441\u044F \u043E\u0442\u0441\u044E\u0434\u0430\u2026\r\n\u0432\u043E\u0437\u044C\u043C\u0438,
    \u043C\u043D\u0435 \u043E\u043D \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
    \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F\u2026\r\n- \u043E\u0444\u0438\u0446\u0435\u0440
    \u2026"
  zeroBasedPageIndex: 1
