  pages:
  - "\u0414\u041E\u0411\u0420\u041E \u041F\u041E\u0416\u0410\u041B\u041E\u0412\u0410\u0422\u042C
    \u0412 \u041A\u041E\u041C\u041F\u041B\u0415\u041A\u0421 \u0413\u0410\u0423\u0421-215"
  - "\u0434\u0430\u043B\u044C\u0448\u0435 \u0430\u0444\u0438\u0448\u0430 \u0440\u0430\u0437\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u0430
    \u043C\u0430\u0440\u043A\u0435\u0440\u043E\u043C, \u043F\u043E\u0447\u0442\u0438
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F
    \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C"
  - "\u0432 \u0441\u0430\u043C\u043E\u043C \u0432\u043D\u0438\u0437\u0443 \u043D\u0430\u0434\u043F\u0438\u0441\u044C
    \u0442\u0435\u043C \u0436\u0435 \u043C\u0430\u0440\u043A\u0435\u0440\u043E\u043C\r\n\u0414\u043B\u044F
    \u0432\u0441\u0435\u0445 \u043D\u043E\u0432\u043E\u043F\u0440\u0438\u0431\u044B\u0432\u0448\u0438\u0445,
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u0435\r\n\u041B\u0443\u0447\u0448\u0435
    \u0441\u043F\u0430\u0441\u0430\u0439\u0442\u0435\u0441\u044C"
  - "\u0415\u0441\u043B\u0438 \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u0431\u0438\u0442\u044C\u0441\u044F
    \u043D\u0430 \u043D\u0438\u0436\u043D\u0438\u0435 \u0443\u0440\u043E\u0432\u043D\u0438
    - \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u043F\u0438\u0442\u0430\u043D\u0438\u0435 \u0442\u0443\u0440\u0435\u043B\u0438
    \u0438 \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043B\u0438\u0444\u0442\r\n\u0418\u043D\u0430\u0447\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
    \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F"
