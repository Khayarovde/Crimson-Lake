  canvasFadeDuration: 0.22
  darkOverlayFadeDuration: 0.18
  playerComponentsToDisable:
  - {fileID: 0}
  playerRigidbody: {fileID: 0}
  freezePlayerRigidbody: 1
  pages:
  - "\u041E\u0431\u0440\u044B\u0432\u043E\u043A \u0413\u0430\u0437\u0435\u0442\u044B"
  - "\u0421\u0442\u043E\u043B\u044C \u0434\u0435\u0448\u0435\u0432\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C
    \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F,
    \u0431\u0443\u0434\u0442\u043E \u043E\u043D\u0430 \u0438\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
    \u0432\u0435\u043A\u0430"
  - "\u041A\u041E\u041B\u041B\u0410\u041F\u0421\r\n- \u043F\u043E \u0434\u0430\u043D\u043D\u044B\u043C
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u043E\u0432, \u043F\u043B\u0430\u043D\u0435\u0442\u0430
    \u0432\u0441\u043A\u043E\u0440\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0435\u0442
    \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043E\u0440\u0431\u0438\u0442\u044B
    \u0432 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435;
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0438\u043A\u0442\u043E
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u043F\u0440\u0438\u0447\u0438\u043D\u044B \u0441\u043B\u0443\u0447\u0438\u0432\u0448\u0435\u0433\u043E\u0441\u044F;
    \u043C\u0438\u0440 \u0443\u0442\u0440\u0430\u0442\u0438\u043B \u0441\u0432\u044F\u0437\u044C
    \u0441 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043E\u043C,
    \u0430 \u0441\u0430\u043C \u0431\u0443\u0434\u0435\u0442 \u0441\u043A\u043E\u0440\u043E
    \u0437\u0430\u043A\u043E\u0432\u0430\u043D \u0432 \u0442\u0451\u043C\u043D\u044B\u0439
    \u043B\u0451\u0434."
  - "\u041D\u0435 \u043F\u0430\u043D\u0438\u043A\u0443\u0439\u0442\u0435, \u0440\u0435\u0448\u0435\u043D\u0438\u0435
    \u0435\u0441\u0442\u044C - \u043E\u0431\u0449\u0430\u044F \u0441\u0435\u0440\u0432\u0438\u0442\u043E\u0440\u0438\u0437\u0430\u0446\u0438\u044F
    \r\n\u0417\u043D\u0430\u0439\u0442\u0435, \u0432\u044B \u0443\u043C\u0440\u0451\u0442\u0435,
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044F \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u0441\u043B\u0430\u0432\u043D\u043E\u0439 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u0438
    \u043D\u0430\u0448\u0435\u0439 \u043C\u043E\u0449\u0438"
  zeroBasedPageIndex: 1
  audioSource: {fileID: 0}
  pageFlipClip: {fileID: 8300000, guid: 95a1eadaa6af6874b999a83311714eff, type: 3}
  pageFlipVolume: 1
