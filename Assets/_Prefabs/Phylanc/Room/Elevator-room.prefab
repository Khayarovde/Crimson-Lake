  darkOverlayFadeDuration: 0.18
  playerComponentsToDisable:
  - {fileID: 0}
  playerRigidbody: {fileID: 0}
  freezePlayerRigidbody: 1
  pages:
  - "\u041D\u0430\u043A\u043B\u0435\u0435\u043D\u043D\u0430\u044F \u043D\u0430 \u043B\u0438\u0444\u0442
    \u0437\u0430\u043F\u0438\u0441\u043A\u0430"
  - "\u041A\u0430\u043A\u043E\u0439-\u0442\u043E \u043F\u0440\u0438\u0434\u0443\u0440\u043E\u043A
    \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043B \u043B\u0438\u0444\u0442,
    \u0432\u043A\u043B\u044E\u0447\u0438\u0432 \u0430\u0432\u0430\u0440\u0438\u0439\u043D\u0443\u044E
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\r\n\u0421\u0430\u043C,
    \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0441\u043C\u043E\u0442\u0430\u043B\u0441\u044F
    \u043A \u043E\u0437\u0435\u0440\u0443. "
  - "\u0412 \u043E\u0431\u0449\u0435\u043C, \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0441\u043F\u043E\u0441\u043E\u0431 - \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443 (\u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
    \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432) \u0447\u0435\u0440\u0435\u0437
    \u043C\u0435\u0439\u043D\u0444\u0440\u0435\u0439\u043C \u0432 \u0441\u0435\u0440\u0432\u0435\u0440\u043D\u043E\u0439.
    (\u041D\u0430\u0439\u0434\u0438 \u0434\u0438\u0441\u043A\u0435\u0442\u0443, \u043E\u043D\u0430
    \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u0430, \u0431\u0435\u0437 \u043D\u0435\u0451
    \u043D\u0438\u043A\u0430\u043A.)\r\n- \u043E\u0444\u0438\u0446\u0435\u0440 \u043E\u0445\u0440\u0430\u043D\u044B
    \u041A."
  zeroBasedPageIndex: 1
  audioSource: {fileID: 6921830949629544921}
  pageFlipClip: {fileID: 8300000, guid: 95a1eadaa6af6874b999a83311714eff, type: 3}
  pageFlipVolume: 1
