--- !u!114 &8396703910536335374
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6630633361759345427}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4acc063d23ee60e4e877e542efff440e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playerTag: Player
  openKey: 101
  keepCanvasStateOnStart: 0
  canvasRoot: {fileID: 0}
  canvasGroup: {fileID: 0}
  itemSpriteImage: {fileID: 0}
  itemSprite: {fileID: 21300000, guid: efee7b66c42d97f4a8957ae110e106cf, type: 3}
  arrowHintText: {fileID: 0}
  arrowHintValue: "A - \u0432\u043B\u0435\u0432\u043E | D -\u0432\u043F\u0440\u0430\u0432\u043E"
  pageCounterText: {fileID: 0}
  darkOverlayImage: {fileID: 0}
  darkOverlayGroup: {fileID: 0}
  pageContentText: {fileID: 0}
  canvasFadeDuration: 0.22
  darkOverlayFadeDuration: 0.18
  playerComponentsToDisable:
  - {fileID: 0}
  playerRigidbody: {fileID: 0}
  freezePlayerRigidbody: 1
  pages:
  - "\u0420\u0435\u0433\u043B\u0430\u043C\u0435\u043D\u0442 \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u0430
    \u043F\u043E \u0440\u0435\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438 \u0438
    \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438"
  - "\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435: \u0432 \u0441\u0432\u044F\u0437\u0438
    \u0441 \u0441\u043B\u043E\u0436\u0438\u0432\u0448\u0435\u0439\u0441\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439,
    \u0432\u0441\u0435\u043C \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u043C
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u0442\u0440\u043E\u0433\u043E
    \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u044D\u0442\u0438\u043C
    \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u043C. \u041D\u0430\u0448\u0430
    \u0434\u0435\u043B\u0438\u043A\u0430\u0442\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u044B
    \u0432\u044B\u0448\u043B\u0430 \u043D\u0430 \u043D\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0441\u0435, \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0435
    \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438, \u0441\u0430\u043C\u0438
    \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0440\u043E\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0434
    \u044D\u0442\u0438\u043C \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0443."
  - "\u0428\u0430\u0433 1: \u0418\u0437\u0432\u043B\u0435\u043A\u0438\u0442\u0435
    \u043E\u0431\u044A\u0435\u043A\u0442 \u0441 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    \u0434\u043B\u044F \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432. \r\n\u0428\u0430\u0433
    2: \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u044C\u0442\u0435 \u0441\u0442\u0435\u0440\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0438 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F.\r\n\u0428\u0430\u0433
    3: \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0442\u043E\u0440\u044B
    \u0434\u043B\u044F \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0430.\r\n\u0428\u0430\u0433
    4: \u041E\u0447\u0438\u0441\u0442\u0438\u0442\u0435 \u043E\u0431\u044A\u0435\u043A\u0442,
    \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0441
    \u043E\u0431\u044A\u0435\u043A\u0442\u0430 \u0443\u0434\u0430\u043B\u0435\u043D\u044B
    \u043A\u0440\u043E\u0432\u044C, \u043C\u0443\u0441\u043E\u0440, \u043A\u043E\u0441\u0442\u0438
    \u0432 \u043D\u0435\u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445
    \u0438 \u0442. \u0434.\r\n"
  - "\u0428\u0430\u0433 5: \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0442\u043E\u0440\u0430
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u044D\u043A\u0437\u043E\u0441\u043A\u0435\u043B\u0435\u0442,
    \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C \u043D\u0435 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u0442\u044C
    \u0442\u043A\u0430\u043D\u0438 \u043E\u0431\u044A\u0435\u043A\u0442\u0430.\n\u0428\u0430\u0433
    6: \u041E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u0439\u0442\u0435 \u0438
    \u0437\u0430\u043F\u0430\u043A\u0443\u0439\u0442\u0435 \u043E\u0431\u044A\u0435\u043A\u0442,
    \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C \u0440\u0430\u0437\u0432\u0435\u0441\u0442\u0438
    \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u043C\u0435\u043D\u044C\u0448\u0435
    \u0433\u0440\u044F\u0437\u0438 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438.\n\u0428\u0430\u0433
    7: \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435 \u043E\u0431\u044A\u0435\u043A\u0442
    \u043A \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044E \u043D\u0430
    \u043D\u0443\u043B\u0435\u0432\u043E\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u0434\u043B\u044F \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u044F\u0434\u0440\u0430.\n\u0416\u0435\u043B\u0430\u0435\u043C
    \u0443\u0434\u0430\u0447\u0438 \u0432 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0438
    \u0432\u0430\u0448\u0438\u0445 \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u043E\u0441\u0442\u0435\u0439,
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A"
  - "\u041F\u0440\u0438\u043C\u0435\u0447\u0430\u043D\u0438\u0435, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u043E\u0435
    \u043C\u0430\u0440\u043A\u0435\u0440\u043E\u043C: \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
    \u0441\u043C\u0435\u043D\u0443 \u043E\u0448\u0442\u0440\u0430\u0444\u043E\u0432\u0430\u043B\u0438
    \u0437\u0430 \u0440\u0430\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u0435, \u0442\u0430\u043A
    \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u043E\u0439, \u0433\u0440\u044F\u0437\u0438,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0440\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F
    \u043E\u0436\u0438\u043B\u0430 \u0438 \u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u0442\u044C
    \u0432 \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044E, \u0442\u0430\u043A
    \u0447\u0442\u043E \u0431\u0443\u0434\u044C\u0442\u0435 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0435\u0435."
  zeroBasedPageIndex: 1
  audioSource: {fileID: 0}
  pageFlipClip: {fileID: 8300000, guid: 95a1eadaa6af6874b999a83311714eff, type: 3}
  pageFlipVolume: 1
